{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gpxcam card",
  "mainBinaryName": "gpxcam-card",
  "identifier": "io.github.tomaszbojanowski.GpxcamCard",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "python3 ../tools/app_frontend.py",
    "beforeBuildCommand": "python3 ../tools/app_frontend.py"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "gpxcam card",
        "width": 900,
        "height": 900,
        "minWidth": 380,
        "minHeight": 480,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "msi", "app", "dmg"],
    "publisher": "Tomasz Bojanowski",
    "homepage": "https://github.com/TomaszBojanowski/gpxcam-t1000e",
    "category": "Utility",
    "shortDescription": "Set up a SenseCAP T1000-E running gpxcam",
    "longDescription": "Shows the state of a SenseCAP T1000-E running gpxcam and sets it up over USB.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
